# ─────────────────────────────────────────────────────────────────────────────
# Sovereignty — environment configuration
# Copy to `.env.local`. NEVER commit real secret values.
# ─────────────────────────────────────────────────────────────────────────────

# ── VoiceStudio (local transcription + voice-cloning UI) ─────────────────────
# URL of the VoiceStudio backend (Docker publishes on 127.0.0.1:3900).
VOICESTUDIO_API_URL="http://127.0.0.1:3900"
# Bearer key for remote/authenticated API access (optional for loopback).
VOICESTUDIO_API_KEY=""

# ── Text-to-speech / voice cloning ───────────────────────────────────────────
# none | voicestudio | openai | elevenlabs
TTS_PROVIDER="none"
TTS_API_URL=""
TTS_API_KEY=""
TTS_VOICE=""

# ── LiveKit (WebRTC video calls) ─────────────────────────────────────────────
# Must match the `keys` entry in livekit.yaml.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="replace-this-with-a-long-random-secret"

# ── Docker ───────────────────────────────────────────────────────────────────
# Admin API key for the VoiceStudio container (required by docker-compose).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OMNIVOICE_API_KEY=""
